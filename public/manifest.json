{
  "name": "ClipSync",
  "short_name": "ClipSync",
  "description": "Secure, cross-device clipboard sync and file transfer directly between browsers using WebRTC.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0a0f19",
  "theme_color": "#0a0f19",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["*/*", "image/*", "video/*", "audio/*", "application/*", "text/*"]
        }
      ]
    }
  }
}
